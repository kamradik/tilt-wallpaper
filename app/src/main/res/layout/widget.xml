<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget (ParallaxWidget): current effect, Next effect, Pause/Resume. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
    android:gravity="center_vertical" android:background="@drawable/widget_background" android:paddingStart="18dp" android:paddingEnd="10dp">
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/tile_label" android:textColor="#99FFFFFF" android:textSize="12sp" android:maxLines="1"/>
    <TextView android:id="@+id/widget_effect" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
  <ImageView android:id="@+id/widget_pause" android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp"
      android:background="@drawable/widget_button" android:src="@drawable/widget_pause" android:layout_marginEnd="8dp"/>
  <ImageView android:id="@+id/widget_next" android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp"
      android:background="@drawable/widget_button" android:src="@drawable/widget_next"/>
</LinearLayout>
